# SuiteTalk Backend Environment Variables

# Database (Postgres + pgvector). Single connection string used by Prisma.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/suitetalk?schema=public"

# Google Gemini API (Live audio + tools)
GEMINI_API_KEY=your_gemini_api_key

# Server
PORT=3001

# Asterisk host. Default 127.0.0.1 works when Asterisk runs in WSL2 and Windows
# port-forwarding is healthy. If the backend can't reach AMI/ARI, set this to the
# WSL eth0 IP (e.g. `ip -4 addr show eth0` inside Ubuntu).
ASTERISK_HOST=127.0.0.1

# Single-hotel bootstrap (created on first start if missing)
HOTEL_NAME=SuiteTalk Hotel
OWNER_NAME=Hotel Owner
OWNER_EMAIL=owner@suitetalk.local
OWNER_PASSWORD=tushar123
